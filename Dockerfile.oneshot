FROM maven:3.9-eclipse-temurin-26 AS jdk-maven

FROM node:26-slim

# ============================================================================
# INSTALL OS DEPENDENCIES
# ============================================================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    ripgrep \
    curl \
  && rm -rf /var/lib/apt/lists/*

COPY --from=jdk-maven /opt/java/openjdk /opt/java/openjdk
COPY --from=jdk-maven /usr/share/maven /usr/share/maven

ENV JAVA_HOME=/opt/java/openjdk
ENV MAVEN_HOME=/usr/share/maven
ENV PATH="${JAVA_HOME}/bin:${MAVEN_HOME}/bin:${PATH}"

RUN java -version && mvn -version

# ============================================================================
# CONFIGURE GIT FOR EFS MOUNTED REPOSITORIES
# ============================================================================
RUN git config --global --add safe.directory '*'

# ============================================================================
# INSTALL CLAUDE CODE CLI GLOBALLY
# ============================================================================
RUN npm install -g @anthropic-ai/claude-code

# ============================================================================
# ENVIRONMENT VARIABLES
# ============================================================================
ENV CLAUDE_CODE_USE_BEDROCK=1
ENV AWS_REGION=us-east-2
ENV ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ENV ANTHROPIC_SMALL_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
ENV CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
ENV MAX_THINKING_TOKENS=1024
ENV NODE_ENV=production

# ============================================================================
# APPLICATION SETUP
# ============================================================================
WORKDIR /app

COPY package*.json ./
COPY tsconfig.json ./

RUN npm ci --production

COPY dist/ ./dist/
COPY oneshot-prompts/ ./oneshot-prompts/

# ============================================================================
# ENTRYPOINT
# ============================================================================
# ONESHOT_ROLE is provided at runtime by ECS and determines whether this
# container runs PLANNER, REVIEWER, IMPLEMENTER, CODE_REVIEWER, or TESTER.
CMD ["node", "dist/oneshot/main.js"]
