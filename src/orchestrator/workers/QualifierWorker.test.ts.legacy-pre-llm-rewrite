  it('directly qualifies strong tickets without invoking the qualifier agent', async () => {
    process.env.ONESHOT_COMMENT_ASSET_BASE_URL = 'https://productFactory.mhkdevsandbox.com'
    process.env.ONESHOT_DASHBOARD_BASE_URL = 'https://productFactory.mhkdevsandbox.com'
    const jiraIssue: QualifierJiraIssue = {
      key: 'CPDEV-200',
      fields: {
        summary: 'Implement member search audit logging for /api/member/search requests',
        description: [
          'When a user searches for a member, the request should log the requester,',
          'applied filters, and response count for compliance review.',
          'Update MemberSearchController and MemberSearchAuditService so the audit record',
          'is written after successful searches and skipped for validation failures.',
          'Add automated verification that covers both the happy path and validation rejection.',
          'Files likely involved: src/main/java/com/mhk/member/MemberSearchController.java',
          'and src/test/java/com/mhk/member/MemberSearchControllerTest.java.',
        ].join(' '),
        labels: ['PFOS'],
        issuetype: { name: 'Story' },
      },
    }
    const acceptanceCriteria = [
      'Given a valid /api/member/search request, when the search completes, then an audit record should be stored.',
      'Given an invalid search request, when validation fails, then no audit record should be written.',
      'Given the controller test suite, when tests run, then both the success and validation cases must pass.',
    ].join('\n')

    const gateResult = scoreTicket({
      summary: jiraIssue.fields.summary,
      description: stringifyJiraFieldValue(jiraIssue.fields.description),
      acceptanceCriteria,
      labels: jiraIssue.fields.labels,
      issuetype: jiraIssue.fields.issuetype?.name,
    })
    const gateDecision = classifyGateResult(gateResult)

    expect(gateResult.score).toBeGreaterThanOrEqual(85)
    expect(gateDecision.disposition).toBe('direct_qualify')

    vi.mocked(resolveBranchForQualification).mockResolvedValue({
      branchName: 'master',
      baseCommitSha: 'abc123def456',
      blockingReasons: [],
      warningReasons: [],
    })

    const worker = new QualifierWorker('/tmp', false) as any
    const repo = {
      id: 1,
      repo_name: 'core-app',
      repo_url: 'https://github.com/mhk-repos/cp-medhok-monorepo.git',
      default_branch: 'master',
    }

    worker.db = {
      getAllRepositories: vi.fn().mockResolvedValue([repo]),
    }

    vi.spyOn(worker, 'resolveQualificationRepo').mockResolvedValue({
      repo,
      disposition: 'single_repo',
      resolutionSource: 'explicit_raw',
      blockingReasons: [],
      candidateRepoIds: [repo.id],
    })

    const buildRepositoryContextSpy = vi.spyOn(worker, 'buildRepositoryContext')
    const getQualifierAgentSpy = vi
      .spyOn(worker, 'getQualifierAgent')
      .mockReturnValue({ assessQualification: vi.fn() })

    const createQualifiedRun = vi.fn().mockResolvedValue({ runId: 74, publishError: null })
    const result = await worker.handleFreshQualification(
      jiraIssue,
      stringifyJiraFieldValue(jiraIssue.fields.description),
      '',
      '/tmp/workspace',
      { id: 77, customer_id: 25 } as any,
      77,
      { id: 25, branch: 'master' } as any,
      { createQualifiedRun } as any,
      null,
      Date.now(),
    )

    expect(result.success).toBe(true)
    const extracted = extractOneShotQualifierComment(result.output)
    expect(extracted.isOneShotComment).toBe(true)
    expect(extracted.body).toContain('![OneShot](https://productFactory.mhkdevsandbox.com/oneshot/oneshot-logo-jira.png)')
    expect(extracted.body).toContain('## OneShot | Qualification Ready')
    expect(extracted.body).toContain('### Requirements Summary')
    expect(extracted.body).toContain('Implement member search audit logging')
    expect(extracted.body).toContain('[Open this run in OneShot Dashboard](https://productFactory.mhkdevsandbox.com/oneshot?view=runs&run=run-74)')
    expect(createQualifiedRun).toHaveBeenCalledWith(expect.objectContaining({
      jiraKey: jiraIssue.key,
      qualificationProvider: 'deterministic',
      qualificationModel: 'none',
    }))
    expect(createQualifiedRun.mock.calls[0]?.[0].repoSelectionMetadata).not.toHaveProperty(
      'qualificationReason',
    )
    expect(buildRepositoryContextSpy).not.toHaveBeenCalled()
    expect(getQualifierAgentSpy).not.toHaveBeenCalled()
  })

