# Copy selected values to ../.env.local or export them in your shell before
# running scripts/local-oneshot-cluster.sh.

# Required for real OneShot consumer work.
GITHUB_REPO_TOKEN=
GITHUB_WRITE_TOKEN=
OPENAI_API_KEY=

# Optional model overrides.
OPENAI_REVIEWER_MODEL=gpt-5.4
OPENAI_CODE_REVIEWER_MODEL=gpt-5.4
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_SMALL_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
ONESHOT_IMPLEMENTER_MODEL_ID=us.anthropic.claude-sonnet-5

# Required only when starting with --with-orchestrator.
JIRA_BASE_URL=
JIRA_USERNAME=
JIRA_TOKEN=

# Set false to skip Maven builds/tests when Artifactory is unavailable.
ONESHOT_MAVEN_BUILDS_ENABLED=false

# Required only when ONESHOT_MAVEN_BUILDS_ENABLED=true for full-delivery
# MedHOK Maven smoke runs. ARTIFACTORY_HOST must be host-only.
ARTIFACTORY_HOST=
MAVEN_USER=
MAVEN_PASSWORD=

# Optional port overrides.
ONESHOT_DASHBOARD_PORT=3001
ONESHOT_LOCAL_MYSQL_PORT=3307
ONESHOT_MOTO_PORT=5002
ONESHOT_PLANNER_HEALTH_PORT=18080
ONESHOT_REVIEWER_HEALTH_PORT=18081
ONESHOT_IMPLEMENTER_HEALTH_PORT=18082
ONESHOT_CODE_REVIEWER_HEALTH_PORT=18083
ONESHOT_TESTER_HEALTH_PORT=18084
ONESHOT_ORCHESTRATOR_HEALTH_PORT=18085
ONESHOT_QUALIFIER_HEALTH_PORT=18086
