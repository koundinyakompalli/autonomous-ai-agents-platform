{
  "name": "specter",
  "version": "2.0.0",
  "description": "Specter - AI Agent Cluster powered by Claude Agent SDK",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-spec-factory-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "dashboard:live": "npm --prefix dashboard run dev:live",
    "cockpit:attended": "zsh scripts/start-investigation-cockpit-attended.zsh",
    "start": "node dist/index.js",
    "check:spec-factory-schema": "node scripts/verify-spec-factory-schema.mjs",
    "test": "vitest",
    "test:spec-factory": "vitest run src/spec-factory src/claude-sdk src/config/index.test.ts src/utils src/orchestrator/JiraClient.test.ts src/orchestrator/database-config.test.ts",
    "governance:check": "vitest run scripts/governance-controls.test.ts",
    "governance:diff": "node scripts/governance-diff.mjs",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist",
    "orchestrator": "node dist/orchestrator/index.js",
    "worker": "node dist/worker-main.js",
    "worker:darci": "WORKER_TYPE=DARCI node dist/worker-main.js",
    "worker:scribe": "WORKER_TYPE=SCRIBE node dist/orchestrator/workers/index.js SCRIBE",
    "worker:prism": "WORKER_TYPE=PRISM node dist/orchestrator/workers/index.js PRISM",
    "worker:qualifier": "WORKER_TYPE=QUALIFIER node dist/worker-main.js",
    "worker:hermes": "WORKER_TYPE=HERMES node dist/orchestrator/workers/index.js HERMES",
    "worker:meridian": "WORKER_TYPE=MERIDIAN node dist/worker-main.js",
    "db:schema": "mysql -h localhost -P 13306 -u document_ai_admin -p < db/schema.sql",
    "worker:bc-intake": "WORKER_TYPE=BC-INTAKE node dist/worker-main.js",
    "worker:bcat-planner": "WORKER_TYPE=BCAT-PLANNER node dist/orchestrator/workers/index.js BCAT-PLANNER",
    "worker:bcat-executor": "WORKER_TYPE=BCAT-EXECUTOR node dist/orchestrator/workers/index.js BCAT-EXECUTOR",
    "worker:notary": "WORKER_TYPE=NOTARY node dist/worker-main.js",
    "worker:veritas": "WORKER_TYPE=VERITAS node dist/worker-main.js",
    "worker:anvil": "WORKER_TYPE=ANVIL node dist/worker-main.js",
    "worker:srlog": "WORKER_TYPE=SRLOG node dist/worker-main.js",
    "harvey": "node dist/harvey-main.js",
    "spec-factory": "node dist/spec-factory/main.js",
    "spec-factory:compose-cleanup": "node dist/spec-factory/compose-cleanup.js",
    "spec-factory:compose-cleanup:dev": "tsx src/spec-factory/compose-cleanup.ts",
    "spec-factory:repair-context-v4": "tsx src/spec-factory/repair/context-v4-backfill-main.ts",
    "spec-factory:repair-artifact-manifests": "tsx src/spec-factory/repair/workspace-manifest-backfill-main.ts",
    "spec-factory:certification:plan": "tsx src/spec-factory/certification/certification-main.ts",
    "spec-factory:certification:evaluate": "tsx src/spec-factory/certification/certification-main.ts",
    "spec-factory:certification:evidence": "tsx src/spec-factory/certification/certification-evidence-main.ts",
    "spec-factory:certification:functional": "npm run test:spec-factory",
    "spec-factory:certification:security": "vitest run src/spec-factory/security/redaction.test.ts src/spec-factory/compose-hard-delete.test.ts src/spec-factory/agents/research-executors.test.ts src/spec-factory/server.test.ts",
    "spec-factory:dev": "SPEC_FACTORY_PORT=3012 tsx watch src/spec-factory/main.ts",
    "oneshot": "node dist/oneshot/main.js",
    "oneshot:docs:dry-run": "tsx src/oneshot/documentation/generate.ts",
    "oneshot:docs:run": "tsx src/oneshot/documentation/run.ts",
    "oneshot:docs:run-all": "tsx src/oneshot/documentation/run.ts --all",
    "oneshot:docs:attach": "tsx src/oneshot/documentation/run.ts",
    "oneshot:recover-planning-handoff": "tsx src/oneshot/tools/recover-planning-handoff.ts",
    "oneshot:recover-plan-contract-violation": "tsx src/oneshot/tools/recover-plan-contract-violation.ts",
    "codex-code-review": "tsx src/codex-code-review/run.ts",
    "oneshot:planner": "ONESHOT_ROLE=PLANNER node dist/oneshot/main.js",
    "oneshot:reviewer": "ONESHOT_ROLE=REVIEWER node dist/oneshot/main.js",
    "oneshot:implementer": "ONESHOT_ROLE=IMPLEMENTER node dist/oneshot/main.js"
  },
  "keywords": [
    "ai",
    "agents",
    "claude",
    "bedrock",
    "autonomous",
    "mcp",
    "llm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.214",
    "@anthropic-ai/sdk": "0.112.3",
    "@aws-sdk/client-bedrock-runtime": "^3.1090.0",
    "@aws-sdk/client-s3": "^3.1090.0",
    "@aws-sdk/client-sqs": "^3.1090.0",
    "@aws-sdk/credential-provider-node": "3.972.70",
    "@aws-sdk/s3-request-presigner": "^3.1090.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/id-generator-aws-xray": "^2.1.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/propagator-aws-xray": "^2.2.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-metrics": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@specter/oneshot-claude-agent-sdk": "npm:@anthropic-ai/claude-agent-sdk@0.3.183",
    "@types/express": "^5.0.6",
    "@types/glob": "^9.0.0",
    "adm-zip": "^0.6.0",
    "axios": "^1.18.1",
    "botbuilder": "^4.23.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "form-data": "^4.0.6",
    "glob": "^13.0.6",
    "jsonrepair": "^3.15.0",
    "mammoth": "^1.12.0",
    "marklassian": "^1.2.1",
    "mysql2": "^3.23.0",
    "openai": "^6.48.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "redis": "^6.1.0",
    "ws": "^8.21.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "overrides": {
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/node": "^26.0.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^10.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
