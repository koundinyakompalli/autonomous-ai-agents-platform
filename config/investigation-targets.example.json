  "queryPacks": [
    {
      "id": "schema_inventory",
      "description": "Metadata-only schema inventory for safe connectivity validation.",
      "environments": ["DEV", "INT", "UAT", "STAGE", "PROD_REPLICA"],
      "allowedTables": ["information_schema.tables"],
      "parameterNames": [],
      "sql": "SELECT table_schema, COUNT(*) AS table_count FROM information_schema.tables WHERE table_schema NOT IN ('mysql', 'performance_schema', 'information_schema', 'sys') GROUP BY table_schema ORDER BY table_count DESC LIMIT 10",
      "maxRows": 10,
      "timeoutMs": 5000,
      "redactionTags": ["metadata_only"]
    },
    {
      "id": "correspondence_metadata_probe",
      "description": "Metadata-only probe confirming correspondence tables exist without reading member PHI.",
      "environments": ["DEV", "INT", "UAT", "STAGE", "PROD_REPLICA"],
      "allowedTables": ["information_schema.tables"],
      "parameterNames": [],
      "sql": "SELECT table_schema, table_name FROM information_schema.tables WHERE table_name IN ('correspondance_tracking', 'correspondance_status') ORDER BY table_schema, table_name LIMIT 25",
      "maxRows": 25,
      "timeoutMs": 5000,
      "redactionTags": ["metadata_only"]
    }
