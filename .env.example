# GENERAL
NODE_ENV=development
LOG_LEVEL=info

# Shared service bind settings
HOST=0.0.0.0
PORT=3000

# DATABASE
# Local development often uses a bastion tunnel on localhost:13306.
DB_HOST=localhost
DB_PORT=13306
DB_USER=document_ai_admin
DB_PASSWORD=change-me
DB_NAME=Specter

# Optional legacy config object values used by src/config/index.ts
MYSQL_HOST=localhost
MYSQL_PORT=13306
MYSQL_USER=document_ai_admin
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=Specter
MYSQL_CONNECTION_LIMIT=10
MYSQL_ENABLED=true

# JIRA
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_POLLING_INTERVAL_MS=60000
RESULT_CHECK_INTERVAL_MS=30000
AUTO_REASSIGN_TICKETS=false

# AWS / BEDROCK / S3
AWS_REGION=us-east-2
S3_BUCKET_PREFIX=specter

# Investigation Cockpit local AWS evidence access.
# Run `aws sso login --profile prod` before starting Cockpit when this profile
# is backed by AWS SSO. Cockpit passes this profile to AWS CLI calls for
# CloudWatch/S3 evidence; LDAP SSH host access does not use SSM. Cockpit derives
# CloudWatch regions from approved target config or AWS region discovery, and
# env-id prefixes from config or bounded Jira-scoped defaults.
INVESTIGATION_AWS_PROFILE=prod

# Local Investigation Cockpit testing only. When true, Cockpit may start a
# MERIDIAN direct local run if the Specter platform DB queue is unavailable.
# Production should keep this false and use the task_management worker queue.
INVESTIGATION_MERIDIAN_DIRECT_FALLBACK=false

# Optional local-only credentials for the AWS SDK default credential chain
# Specter does not read these through src/config anymore.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Claude Code / Claude Agent SDK on Bedrock
CLAUDE_CODE_USE_BEDROCK=1
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ANTHROPIC_SMALL_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
CLAUDE_CODE_MAX_OUTPUT_TOKENS=4096
MAX_THINKING_TOKENS=1024

# Direct Bedrock callers in Harvey/orchestrator still reference these names
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
BEDROCK_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# OneShot dashboard AI statistics
ONESHOT_STATISTICS_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
ONESHOT_STATISTICS_MIN_SAMPLE_SIZE=5
# ONESHOT_STATISTICS_REFRESH_INTERVAL_MS_24H=1800000
# ONESHOT_STATISTICS_REFRESH_INTERVAL_MS_7D=3600000
# ONESHOT_STATISTICS_REFRESH_INTERVAL_MS_30D=7200000
# ONESHOT_STATISTICS_REFRESH_INTERVAL_MS_ALL=21600000

# Watchdog log investigator
# fake_no_evidence keeps the shell deterministic; llm_log_analysis uses MCP evidence + the configured LLM.
WATCHDOG_INVESTIGATOR=fake_no_evidence
# Watchdog uses Claude Agent SDK on Bedrock through the ECS task role/default AWS credential chain.
WATCHDOG_LLM_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
WATCHDOG_BEDROCK_REGION=us-east-2
WATCHDOG_LLM_MAX_OUTPUT_TOKENS=1800
WATCHDOG_CLAUDE_MAX_TURNS=1
WATCHDOG_CLAUDE_MAX_BUDGET_USD=1
WATCHDOG_CLAUDE_TIMEOUT_MS=120000
WATCHDOG_CLAUDE_PLAN_TIMEOUT_MS=60000
WATCHDOG_AGENTIC_MCP_LOOP=enabled
WATCHDOG_MAX_ACTIVE_RUNS_PER_OPERATOR=3
WATCHDOG_BACKGROUND_JOBS=disabled
WATCHDOG_REAPER_INTERVAL_SECONDS=60
WATCHDOG_CLEANUP_INTERVAL_SECONDS=900
WATCHDOG_CLARIFICATION_TTL_HOURS=48
# Shared MCP endpoint for local/dev container smoke tests.
# The MCP healthcheck is authoritative for auth mode; this value is a display fallback.
# WATCHDOG_MCP_HTTP_URL=http://host.containers.internal:8000/mcp
# WATCHDOG_MCP_AUTH_MODE=sandbox_static_secret
# Local container-only escape hatch. Keep unset/false in real production behind ALB OIDC.
WATCHDOG_ALLOW_LOCAL_OPERATOR_FALLBACK=false

# Dedicated Watchdog evidence payload bucket.
# Do not point this at the DARCI task bucket; Watchdog evidence is redacted but still investigation data.
WATCHDOG_EVIDENCE_BUCKET=specter-watchdog-evidence
WATCHDOG_EVIDENCE_REGION=us-east-2

# INVESTIGATION COCKPIT
# Jira context is fetched before adapters execute. Do not store real tokens in
# this file; export them in the operator shell or a local, gitignored env file.
INVESTIGATION_JIRA_TRIGGER_LABEL=investigation-cockpit
# Optional: set this once if Jira Environment is a custom field in your site.
# Cockpit uses these IDs before Jira field-name discovery and before label/text
# inference. Comma-separate multiple IDs if projects use different fields.
# INVESTIGATION_JIRA_ENVIRONMENT_FIELD_IDS=customfield_12345
# INVESTIGATION_JIRA_FIELD_METADATA_CACHE_TTL_MS=600000
INVESTIGATION_TARGET_THROTTLE_STORE=memory
INVESTIGATION_QUEUE_AUTOSTART=true
# Bounded repository discovery searches non-sensitive technical terms across
# the approved GitHub organization, then inspects at most three matching repos.
# It uses GITHUB_REPO_TOKEN/GH_TOKEN/GITHUB_TOKEN, or the attended gh session.
INVESTIGATION_GITHUB_CATALOG_DISCOVERY=true
INVESTIGATION_GITHUB_ORG=mhk-repos

# Operator LDAP SSH defaults used by Cockpit host probes and by Meridian DB
# tunnels when a Meridian-specific credential is not configured.
INVESTIGATION_OPERATOR_SSH_USER=
INVESTIGATION_OPERATOR_SSH_PASSWORD=
INVESTIGATION_SSH_PORT=22
INVESTIGATION_CONFIG_PROBE_PATHS=/opt/software/medhok,/opt/software/medhok/batch

# Optional runtime target derivation for local operator testing. Prefer
# approved target config in production. If host derivation is enabled, Cockpit
# only uses bounded Jira host context or this explicit template/host.
# INVESTIGATION_SSH_HOST_TEMPLATE={client}-{env}.example.internal
# INVESTIGATION_SSH_HOST_ALLOW_PATTERN=\\.example\\.internal$

# Optional readonly DB target. If DB username/password are omitted, Cockpit and
# Meridian may reuse INVESTIGATION_OPERATOR_SSH_USER/PASSWORD as the operator
# LDAP credential fallback.
# INVESTIGATION_DB_HOST=127.0.0.1
# INVESTIGATION_DB_PORT=3306
# When INVESTIGATION_DB_HOST points to a local tunnel, set these so Meridian can
# open its own LDAP SSH DB tunnel instead of reusing the local endpoint.
# INVESTIGATION_SSH_HOST=client-prod-login.example.internal
# INVESTIGATION_DB_REMOTE_HOST=client-prod-replica-db.internal
# INVESTIGATION_DB_REMOTE_PORT=3306
# INVESTIGATION_DB_USERNAME=
# INVESTIGATION_DB_PASSWORD=
# INVESTIGATION_DB_DATABASE=medhok

# SHARED STORAGE
EFS_MOUNT_PATH=/mnt/efs/specter-repo
REPOSITORY_PATH=/mnt/efs/specter-repo/repositories
DOCUMENTS_PATH=/mnt/efs/specter-repo/documents

# SPEC FACTORY / COMPOSE
COMPOSE_MARKITDOWN_URL=http://localhost:8080
# Optional comma-separated suffix allowlist for Confluence page ingestion.
# Example: COMPOSE_CONFLUENCE_ALLOWED_HOST_SUFFIXES=atlassian.net
COMPOSE_CONFLUENCE_ALLOWED_HOST_SUFFIXES=
# Sidecar URL ingestion guardrails for non-YouTube URL sources.
MARKITDOWN_URL_MAX_BYTES=10485760
MARKITDOWN_URL_FETCH_TIMEOUT_SECONDS=15
MARKITDOWN_URL_MAX_REDIRECTS=5
# Sidecar upload/conversion size + duration ceilings. Optional; defaults shown.
# MARKITDOWN_MAX_BYTES=52428800          # max /convert file size (50 MiB)
# COMPOSE_AUDIO_MAX_BYTES=524288000       # max media upload for transcription (500 MiB)
# COMPOSE_AUDIO_MAX_SECONDS=3600          # max media duration before 413
# Transcription segments are 16kHz mono MP3 (not WAV) so a 300s segment is
# ~3.2MB base64 instead of ~12.8MB — WAV exceeded the Voxtral request-body limit.
# COMPOSE_AUDIO_MP3_BITRATE=64k                 # sidecar mp3 bitrate for segments
# COMPOSE_VOXTRAL_MAX_REQUEST_BYTES=8000000     # reject a segment over this base64 size before the call
# In-process maintenance intervals (spec-factory app). Optional; defaults shown.
# COMPOSE_CONVERSION_POLL_MS=5000         # conversion drain poll
# COMPOSE_CHAT_TIMEOUT_MS=300000          # clarification agent turn timeout
# Compose repo grounding: attach selected/identified code repos as read-only
# checkouts so the clarification agent greps real code. Optional; defaults shown.
# COMPOSE_REPO_GROUNDING_ENABLED=true       # off => legacy metadata-only repositories.md
# COMPOSE_MAX_GROUNDED_REPOS=3              # cap (operator-selected prioritized)
# COMPOSE_REPO_GROUNDING_TOOL_BUDGET=40     # max repo grep/Read tool calls per turn
# COMPOSE_REPO_GROUNDING_TIMEOUT_MS=120000  # clone/scan budget per turn
# Media transcription timeouts (audio/video → Voxtral). Bounded PER STAGE so
# long, healthy media is not failed by one cumulative budget. Optional; the
# worker uses these defaults when unset.
# COMPOSE_CONVERT_TIMEOUT_MS=300000            # markitdown /convert (docs, URLs)
# COMPOSE_EXTRACT_AUDIO_TIMEOUT_MS=600000       # ffmpeg audio extraction (sidecar)
# COMPOSE_TRANSCRIBE_SEGMENT_TIMEOUT_MS=120000  # per Voxtral segment (Bedrock)
# COMPOSE_CONVERSION_LEASE_MS=2400000           # must exceed worst-case total per source
# Scheduled retention sweep: purge EFS workspaces + S3 raw uploads for sessions
# archived past the window. Off by default; validate with a dry run, then enable.
# COMPOSE_RETENTION_CLEANUP_ENABLED=false
# COMPOSE_WORKSPACE_RETENTION_DAYS=30
# COMPOSE_CLEANUP_DRY_RUN=true                  # report-only until you trust the candidate set
# COMPOSE_CLEANUP_LIMIT=50                       # max sessions per sweep
# COMPOSE_RETENTION_SWEEP_MS=21600000            # interval between sweeps (default 6h)

# Optional legacy local storage paths from src/config/index.ts
REPO_STORAGE_PATH=./data/repos
REPORT_STORAGE_PATH=./data/reports

# WORKERS
WORKER_TYPE=DARCI
STATUS_HOST=0.0.0.0
STATUS_PORT=8080
ENABLE_WEBHOOKS=false
# WEBHOOK_URL=https://example.com/specter-webhook
# WEBHOOK_SECRET=change-me

# Claude SDK runtime limits
TASK_TIMEOUT_MINUTES=60
MAX_ITERATIONS=0
MAX_CALLS_PER_MINUTE=60
MAX_CONCURRENT_TASKS=5

# HARVEY (TEAMS BOT)
HARVEY_HOST=0.0.0.0
HARVEY_PORT=3978
RESULT_POLL_INTERVAL=15000
TEAMS_APP_ID=
TEAMS_APP_PASSWORD=
TEAMS_TENANT_ID=

# AGENT-SPECIFIC OPTIONALS
# BEACON / MOANA
MOANA_BASE_URL=https://moana.example.com/api
MOANA_USER_ID=beacon@specter.example.com

# BCAT
BCAT_TARGET_PROJECT=CPSUP
BCAT_APPROVER_FIELD=customfield_10003
BCAT_CUSTOMER_FIELD=customfield_XXXXX
BCAT_ENVIRONMENT_FIELD=customfield_XXXXX
BCAT_SOLUTION_FIELD=customfield_XXXXX
BCAT_REQUEST_TYPE_FIELD=customfield_10010
